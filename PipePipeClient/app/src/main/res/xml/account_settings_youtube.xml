<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:app="http://schemas.android.com/apk/res-auto"
                  android:title="@string/settings_category_youtube_account_title">
    <Preference
            android:key="@string/login_key"
            android:summary="@string/login_warning"
            android:title="@string/login_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />
    <Preference
            android:key="@string/logout_key"
            android:title="@string/logout_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <PreferenceCategory
            android:layout="@layout/settings_category_header_layout"
            android:title="@string/youtube_account_sync_category_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false">

        <Preference
                android:key="@string/youtube_sync_all_key"
                android:title="@string/youtube_sync_all_title"
                android:summary="@string/youtube_sync_all_summary"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="@string/youtube_sync_subscriptions_key"
                android:title="@string/youtube_sync_subscriptions_title"
                android:summary="@string/youtube_sync_subscriptions_summary"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="@string/youtube_sync_history_key"
                android:title="@string/youtube_sync_history_title"
                android:summary="@string/youtube_sync_history_summary"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                android:defaultValue="true"
                android:key="@string/youtube_auto_sync_key"
                android:title="@string/youtube_auto_sync_title"
                android:summary="@string/youtube_auto_sync_summary"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                android:defaultValue="true"
                android:key="@string/youtube_report_history_key"
                android:title="@string/youtube_report_history_title"
                android:summary="@string/youtube_report_history_summary"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />
    </PreferenceCategory>
